# Khung hiện tại chưa gọi provider, ngay cả khi bật cờ này.
CONVERSIONS_ENABLED=false
APP_ORIGIN=http://localhost:3000

# Server only. Để trống khi chỉ dựng giao diện.
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_ENV=sandbox
# 32 byte ngẫu nhiên, mã hóa base64url; không dùng giá trị ví dụ làm khóa thật.
JOB_TOKEN_KEY=
TURNSTILE_SECRET_KEY=

# Site key công khai, chỉ cấu hình khi tích hợp Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
